# ==========================================
# SUPABASE CONFIGURATION (Template)
# ==========================================
VITE_SUPABASE_URL=https://cxuufrkigkewjsrqgjqf.supabase.co/

# Publishable key (sb_publishable_...) : remplace l'ancienne clé "anon".
# Sans danger côté navigateur (protégée par les règles RLS).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-cle

# Secret key (sb_secret_...) : remplace l'ancienne clé "service_role".
# ⚠️ JAMAIS de préfixe VITE_ : elle contourne le RLS et ne doit jamais
# arriver dans le navigateur. À utiliser uniquement côté serveur
# (Edge Functions, scripts, backend).
SUPABASE_SECRET_KEY=sb_secret_votre-cle

# ==========================================
# GROQ IA CONFIGURATION (OPTIONNEL)
# ==========================================
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.1-8b-instant
